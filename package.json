{
  "name": "context-viewer",
  "displayName": "Context Viewer",
  "description": "View-only Token Gauge and Context Inventory for Antigravity Conversations.",
  "version": "0.1.0",
  "publisher": "local",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/fattung79/antigravity-context-extension"
  },
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.107.0"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Context Viewer",
      "properties": {
        "contextViewer.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/.gemini/antigravity/"
          ],
          "markdownDescription": "Data roots to scan (each has `brain/`, `conversations/`, `annotations/`, `conversation_summaries.db`). `~` is expanded."
        },
        "contextViewer.maxConversations": {
          "type": "number",
          "minimum": 1,
          "default": 3,
          "description": "Caps the Conversations shown in the tree, counting the Active Conversation. The status bar shows the Active Conversation only."
        },
        "contextViewer.recentExpiryMinutes": {
          "type": "number",
          "default": 3,
          "description": "A Recent Conversation is dropped this many minutes after it entered the Recent list."
        },
        "contextViewer.threshold": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "number",
            "minimum": 1,
            "maximum": 10000
          },
          "markdownDescription": "**Unit: thousands of tokens (k).** Enter `190` for 190,000, not `190000`. Per-model Threshold, keyed by model name without the effort level, e.g. `{ \"Gemini 3.8 Flash\": 190 }`."
        },
        "contextViewer.threshold.default": {
          "type": [
            "number",
            "null"
          ],
          "default": 150,
          "markdownDescription": "**Unit: thousands of tokens (k).** Enter `150` for 150,000, not `150000`. Fallback Threshold that drives the colours. Clear it to use the model's Context window as the Threshold.",
          "minimum": 1,
          "maximum": 10000
        },
        "contextViewer.limits": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "number",
            "minimum": 1000
          },
          "markdownDescription": "**Unit: tokens (not k).** Enter `256000`, not `256`. Per-model Context window override, keyed by model name without the effort level, e.g. `{ \"Gemini 3.8 Flash\": 256000 }`."
        },
        "contextViewer.limits.default": {
          "type": [
            "number",
            "null"
          ],
          "default": null,
          "markdownDescription": "**Unit: tokens (not k).** Enter `256000`, not `256`. Last-resort Context window when no other source knows the model's. Empty: no limit known.",
          "minimum": 1000
        },
        "contextViewer.heavyItemPercent": {
          "type": "number",
          "default": 5,
          "description": "Chat Messages items above this % of the Context window are highlighted."
        },
        "contextViewer.hoverChars": {
          "type": "number",
          "default": 2000,
          "description": "Hover cut-off for chat item text: head 75%, tail 25%; thinking budget 50%."
        },
        "contextViewer.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "info",
            "debug"
          ],
          "default": "error",
          "description": "Output channel verbosity."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "contextViewer",
          "title": "Context Viewer",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "contextViewer": [
        {
          "id": "contextViewer.inventory",
          "name": "Context Inventory"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "contextViewer.inventory",
        "contents": "No configured data root was found on this host. Set [contextViewer.roots](command:workbench.action.openSettings?%5B%22contextViewer.roots%22%5D).",
        "when": "contextViewer.noRoot"
      },
      {
        "view": "contextViewer.inventory",
        "contents": "Open or start a Conversation in the agent panel.\n[Refresh](command:contextViewer.refresh)",
        "when": "!contextViewer.noRoot"
      }
    ],
    "commands": [
      {
        "command": "contextViewer.refresh",
        "title": "Context Viewer: Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "contextViewer.reveal",
        "title": "Context Viewer: Reveal Conversation"
      },
      {
        "command": "contextViewer.toggleLargestFirst",
        "title": "Context Viewer: Sort Chat Messages Largest First",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "contextViewer.toggleLargestFirst.active",
        "title": "Context Viewer: Sort Chat Messages by Step Order",
        "icon": "$(list-ordered)"
      },
      {
        "command": "contextViewer.collapseAll",
        "title": "Context Viewer: Collapse All",
        "icon": "$(collapse-all)"
      },
      {
        "command": "contextViewer.openItem",
        "title": "Context Viewer: Open item content",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "contextViewer.openItem",
          "when": "false"
        }
      ],
      "view/item/context": [
        {
          "command": "contextViewer.openItem",
          "when": "view == contextViewer.inventory && viewItem =~ /^(chat|section|tool)$/",
          "group": "inline"
        },
        {
          "command": "contextViewer.openItem",
          "when": "view == contextViewer.inventory && viewItem =~ /^(chat|section|tool)$/",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "contextViewer.toggleLargestFirst",
          "when": "view == contextViewer.inventory && !contextViewer.largestFirst",
          "group": "navigation@1"
        },
        {
          "command": "contextViewer.toggleLargestFirst.active",
          "when": "view == contextViewer.inventory && contextViewer.largestFirst",
          "group": "navigation@1"
        },
        {
          "command": "contextViewer.refresh",
          "when": "view == contextViewer.inventory",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.107.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
